# Copy to /etc/ury/deploy.conf on the server (owner root, chmod 600). NEVER commit the real file.
# Read by deploy/backup.sh, deploy/health.sh and deploy/update.sh.

COMPOSE_DIR=/opt/ury/frappe_docker           # where frappe_docker and its .env are
COMPOSE_FILES="-f compose.yaml -f overrides/compose.mariadb.yaml -f overrides/compose.redis.yaml -f /opt/ury/app/deploy/compose.ury.yaml"
SITES="rehearsal.smst.internal shop.smst.internal"   # the sites to back up and to check
ACTIVE_SITE=rehearsal.smst.internal          # the one in service (deploy_check runs on it)

# --- mail (msmtp is set up in /etc/msmtprc; docs/deploy/operations.md)
MAIL_TO=owner@example.com
MAIL_FROM=ury-server@example.com
SERVER_NAME=sanyu-server

# --- backups
BACKUP_DIR=/var/backups/ury                  # encrypted sets on this machine
BACKUP_PASSPHRASE_FILE=/etc/ury/backup-passphrase   # chmod 600; the same value is in the password manager
RCLONE_REMOTE=r2:ury-backups                 # the rclone remote (Cloudflare R2) and the bucket
KEEP_LOCAL_DAYS=14
KEEP_REMOTE_DAYS=90

# --- health: when a mail is sent
LOG_DIR=/var/log/ury
KEEP_LOG_DAYS=7
MIN_AVAILABLE_MB=1000        # available memory below this
MAX_SWAP_USED_MB=1000        # swap in use above this
MAX_DISK_PERCENT=80
SSD_DEVICE=/dev/nvme0           # the drive smartctl reads (`lsblk -d`: nvme0n1 -> /dev/nvme0, sda -> /dev/sda); empty = not checked
MAX_SSD_USED_PERCENT=80      # the life of the SSD used, in percent
MAX_BACKUP_AGE_HOURS=26
ALERT_CONSECUTIVE=2          # memory and swap fluctuate: mailed only when over the limit at this many hourly checks in a row.
                             # NOT counted (mailed at the first check): a service that is not running, the disk, the backup, the drive.

# --- the drive (NVMe): the values of a good reading, from `sudo smartctl -a /dev/nvme0`. These only get worse, so the first reading that is
#     worse is a mail ("硬盘在恶化，需要换盘") and the same state is mailed once. Empty = nothing is compared.
#     Unsafe Shutdowns: a mail for each increase (once), only when MAIL_TO is not the example address.
SSD_BASELINE_DATE=2026-11-21
SSD_BASELINE_MEDIA_ERRORS=7  # Media and Data Integrity Errors
SSD_BASELINE_SPARE=75        # Available Spare, in percent
SSD_BASELINE_UNSAFE=46       # Unsafe Shutdowns
SLOW_SECONDS=2               # an order that took longer is counted as slow
ALERT_REPEAT_HOURS=6         # the same alert is not mailed again before this

# --- the stability report (deploy/stability_report.sh): the period starts here; the limits are in the script (docs/deploy/operations.md 5.2)
#STABILITY_FROM="2026-12-14 08:00:00"
