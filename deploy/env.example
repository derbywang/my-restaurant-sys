# Copy to /opt/ury/frappe_docker/.env on the server (chmod 600). NEVER commit the real file: the repository is public.
# Values in <...> are made on the server; see docs/deploy/server-setup.md.

# --- the image built on the server (docs/deploy/server-setup.md, step 2)
CUSTOM_IMAGE=ury
CUSTOM_TAG=<release tag, e.g. 2026-12-01>
PULL_POLICY=never
RESTART_POLICY=unless-stopped
ERPNEXT_VERSION=v15.124.2

# --- the database (the root password of MariaDB: openssl rand -base64 24; keep it in the password manager too)
DB_PASSWORD=<generated>

# --- which site answers. Port 80 (tablets, registers, the tunnel) serves ACTIVE_SITE; port 8081 serves STAGING_SITE.
# The switch of 12/19 is: exchange the two values, then `docker compose up -d frontend frontend-staging`.
ACTIVE_SITE=rehearsal.smst.internal
STAGING_SITE=shop.smst.internal
# the address of this server in the shop's network (DHCP reservation in the router); the ports are published on it only
LAN_IP=<192.168.x.y>

# --- memory: an 8 GB laptop (docs/deploy/operations.md, "最小配置的验证")
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
INNODB_BUFFER_POOL=1G

# --- the real address of the customer: requests of the tunnel come from the host (cloudflared), through Docker's gateway
UPSTREAM_REAL_IP_ADDRESS=172.16.0.0/12
UPSTREAM_REAL_IP_HEADER=CF-Connecting-IP
UPSTREAM_REAL_IP_RECURSIVE=off
CLIENT_MAX_BODY_SIZE=50m
PROXY_READ_TIMEOUT=120
